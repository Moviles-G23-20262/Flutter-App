        </mxCell>
        <mxCell id="v3" parent="1" style="swimlane;startSize=44;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#202A6A;swimlaneFillColor=#FFFFFF;strokeColor=#202A6A;strokeWidth=2;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=left;spacingLeft=16;fontFamily=Fraunces;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DFraunces;" value="1 · Layered architecture (Clean Architecture)" vertex="1">
          <mxGeometry height="760" width="720" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="v4" parent="v3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FA;strokeColor=#202A6A;strokeWidth=2;fontColor=#0E122F;fontSize=14;align=left;verticalAlign=top;spacing=14;fontFamily=Outfit;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOutfit;" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Presentation&lt;/b&gt;  &lt;i&gt;lib/Presentation&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Screens &amp; widgets — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;HomeScreen · ChatView · MeetingPointScreen&lt;/span&gt;&lt;br&gt;• View-models — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;ChatState · AccountState · MeetingPlannerState&lt;/span&gt;&lt;br&gt;• Navigation &amp; app-wide state — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;AppState&lt;/span&gt;&lt;br&gt;• Theme &amp; formatters" vertex="1">
          <mxGeometry height="150" width="660" x="30" y="64" as="geometry" />
        </mxCell>
        <mxCell id="v5" parent="v3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FA;strokeColor=#202A6A;strokeWidth=2;fontColor=#0E122F;fontSize=14;align=left;verticalAlign=top;spacing=14;fontFamily=Outfit;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOutfit;fillColor=#C6C9E2;" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Domain&lt;/b&gt;  &lt;i&gt;lib/Domain · pure Dart, no UI&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Entities — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;MaterialEntity · ExchangeEntity · MeetingProposalEntity&lt;/span&gt;&lt;br&gt;• Use cases — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;PlaceOrderUseCase · ProposeMeetingUseCase&lt;/span&gt;&lt;br&gt;• Repository contracts — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;ChatRepository · MeetupRepository&lt;/span&gt;&lt;br&gt;• Strategies · rules · &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;DataException&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="660" x="30" y="274" as="geometry" />
        </mxCell>
        <mxCell id="v6" parent="v3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FA;strokeColor=#202A6A;strokeWidth=2;fontColor=#0E122F;fontSize=14;align=left;verticalAlign=top;spacing=14;fontFamily=Outfit;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOutfit;" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Data&lt;/b&gt;  &lt;i&gt;lib/Data&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Repository implementations — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;ChatRepositoryImpl · MeetupRepositoryImpl&lt;/span&gt;&lt;br&gt;• Data sources — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;MarketplaceRemoteDataSource · SecureSessionStorage&lt;/span&gt;&lt;br&gt;• Device — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;DeviceLocationDataSource&lt;/span&gt; (GPS)&lt;br&gt;• JSON mappers — &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;marketplace_models.dart&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="660" x="30" y="484" as="geometry" />
        </mxCell>
        <mxCell id="v7" parent="v3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F4F6;strokeColor=#8B94D0;strokeWidth=1.5;fontColor=#404045;fontSize=13;spacing=8;fontFamily=Outfit;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOutfit;align=center;" value="&lt;b&gt;core/&lt;/b&gt;  &lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;AppDependencies&lt;/span&gt; wires Data implementations into Domain use cases and hands them to Presentation&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;ApiClient&lt;/span&gt; is the single HTTP client for the NestJS API (JWT, timeouts, error messages)" vertex="1">
          <mxGeometry height="76" width="660" x="30" y="664" as="geometry" />
        </mxCell>
