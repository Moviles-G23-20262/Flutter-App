        <mxCell id="v1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E122F;fontFamily=Outfit;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOutfit;fontFamily=Fraunces;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DFraunces;fontColor=#0E122F;" value="&lt;span style=&quot;font-size: 28px;&quot;&gt;&lt;b&gt;uwu&lt;/b&gt;&lt;/span&gt;" vertex="1">
