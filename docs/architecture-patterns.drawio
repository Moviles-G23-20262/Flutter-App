  <diagram id="campusswap-patterns" name="Architectural patterns">
    <mxGraphModel dx="1212" dy="675" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="6570" background="#FAFAFC" math="0" shadow="0">
