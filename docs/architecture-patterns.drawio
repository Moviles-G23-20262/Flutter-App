        <mxCell id="v13" parent="v10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF0FA;strokeColor=#3B4DC4;strokeWidth=1.5;fontColor=#0E122F;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Outfit;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOutfit;" value="&lt;b&gt;Model — Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;&quot;&gt;&lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;PlaceOrderUseCase · SendMessageUseCase …&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:12px;&quot;&gt;ExchangeEntity · MaterialEntity · FreeSlot&lt;/span&gt;&lt;br&gt;Business rules and data, no Flutter&lt;/span&gt;" vertex="1">
